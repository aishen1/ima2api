#!/bin/bash
# 配置变更后：重启服务使端口等改动生效
LOG_FILE="${TRIM_PKGVAR:-/tmp/ima2api-var}/info.log"
echo "$(date '+%Y-%m-%d %H:%M:%S') - [config_callback] restarting" >> "${LOG_FILE}" 2>/dev/null || true
"${TRIM_APPDEST}/cmd/main" stop >/dev/null 2>&1 || true
"${TRIM_APPDEST}/cmd/main" start >/dev/null 2>&1 || true
exit 0
