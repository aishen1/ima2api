#!/bin/bash
# 卸载前：停止服务
LOG_FILE="${TRIM_PKGVAR:-/tmp/ima2api-var}/info.log"
log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - [uninstall_init] $1" >> "${LOG_FILE}" 2>/dev/null || true; }

log_msg "=== uninstall_init ==="
"${TRIM_APPDEST}/cmd/main" stop >/dev/null 2>&1 || true
pkill -9 -f "ima2api/server.js" 2>/dev/null || true
exit 0
